{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbi.local/schemas/orbi-upstream-candidate-v1.schema.json",
  "title": "ORBI Upstream Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "orbi.upstream.candidate.v1"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "commit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "minLength": 7
          }
        }
      }
    }
  }
}
