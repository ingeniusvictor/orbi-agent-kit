{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbi.local/schemas/orbi-adoption-plan-v1.schema.json",
  "title": "ORBI Adoption Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "force",
    "target",
    "entries",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "orbi.adoption.plan.v1"
    },
    "mode": {
      "enum": [
        "dry-run",
        "apply"
      ]
    },
    "force": {
      "type": "boolean"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "destination",
          "exists",
          "action",
          "willWrite"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "exists": {
            "type": "boolean"
          },
          "action": {
            "enum": [
              "CREATE",
              "SKIP",
              "OVERWRITE"
            ]
          },
          "willWrite": {
            "type": "boolean"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "create",
        "skip",
        "overwrite",
        "writes"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "create": {
          "type": "integer",
          "minimum": 0
        },
        "skip": {
          "type": "integer",
          "minimum": 0
        },
        "overwrite": {
          "type": "integer",
          "minimum": 0
        },
        "writes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
